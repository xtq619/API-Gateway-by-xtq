# 数据库连接
DATABASE_URL=postgresql+asyncpg://gateway:gateway_secret@localhost:5432/api_gateway
DATABASE_URL_SYNC=postgresql://gateway:gateway_secret@localhost:5432/api_gateway

# Redis 连接
REDIS_URL=redis://localhost:6379/0

# JWT 配置
SECRET_KEY=请替换为随机生成的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API Key 前缀
API_KEY_PREFIX=sk-

# Fernet 加密密钥（用于加密存储上游模型的 API Key）
# 生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=请运行上面的命令生成并替换

# 调试模式
DEBUG=true

# 每日摘要（true/false）
DIGEST_ENABLED=true
DIGEST_CRON=0 8 * * *

# 邮箱推送（QQ 邮箱示例：开启 SMTP 后用授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASSWORD=你的SMTP授权码
SMTP_SENDER=你的QQ邮箱@qq.com
SMTP_RECIPIENTS=["收件人1@example.com"]
